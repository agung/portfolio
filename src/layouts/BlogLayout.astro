---
import PortfolioStyles from "../components/PortfolioStyles.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="id" data-language="id">
	<head>
		<PortfolioStyles />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F3EEE3" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Reddit+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{title} | Agung Nugraha</title>
		<script is:inline>
			try {
				const language = localStorage.getItem("nugraha-language");
				if (language === "en" || language === "id") {
					document.documentElement.dataset.language = language;
					document.documentElement.lang = language;
				}
				if (localStorage.getItem("nugraha-theme") === "dark")
					document.documentElement.dataset.theme = "dark";
			} catch {}
		</script>
		<style is:global>
			.blog-page {
				width: min(1000px, calc(100% - 48px));
				margin: 0 auto;
				padding: 64px 0 96px;
			}
			.blog-kicker {
				padding-left: 8px;
				border-left: 2px solid var(--accent);
				color: var(--text);
				font: 12px/1.5 var(--mono);
			}
			.blog-meta {
				color: var(--muted);
				font: 12px/1.5 var(--mono);
			}
			.blog-page h1 {
				max-width: 820px;
				margin: 12px 0 16px;
				font-size: clamp(42px, 7vw, 76px);
				line-height: 1.02;
				letter-spacing: -0.055em;
			}
			.blog-intro {
				max-width: 640px;
				margin: 0;
				color: var(--muted);
				font-size: 19px;
			}
			.blog-list {
				margin-top: 64px;
				border-top: 1px solid var(--line);
			}
			.blog-entry {
				display: grid;
				grid-template-columns: 150px minmax(0, 1fr);
				gap: 4px;
				padding: 24px 0;
				border-bottom: 1px solid var(--line);
				text-decoration: none;
			}
			.blog-entry h2 {
				margin: 0 0 8px;
				font-size: clamp(22px, 3vw, 30px);
				line-height: 1.2;
				text-decoration: none;
				transition: text-decoration-color 180ms ease;
			}
			.blog-entry:is(:hover, :focus-visible) h2 {
				text-decoration: underline;
				text-decoration-color: var(--accent);
				text-underline-offset: 5px;
			}
			.blog-entry p {
				max-width: 620px;
				margin: 0;
				color: var(--muted);
			}
			.blog-category {
				display: inline-block;
				margin-top: 12px;
				padding: 3px 7px;
				border: 1px solid var(--line);
				color: var(--muted);
				font: 11px/1.4 var(--mono);
			}
			.blog-back {
				display: inline-block;
				margin-bottom: 28px;
				color: var(--muted);
				font: 12px var(--mono);
				text-decoration: none;
			}
			.blog-back:hover {
				color: var(--text);
				text-decoration: none;
			}
			.blog-article {
				max-width: 740px;
				margin: 0 auto;
			}
			.blog-article h1 {
				margin-bottom: 20px;
			}
			.blog-article .blog-meta {
				display: flex;
				gap: 16px;
				margin: 14px 0 48px;
				color: var(--muted);
			}
			.blog-content {
				font-size: 18px;
				line-height: 1.8;
			}
			.blog-content h2 {
				margin: 42px 0 12px;
				font-size: 28px;
				line-height: 1.25;
				letter-spacing: -0.03em;
			}
			.blog-content p {
				margin: 0 0 22px;
			}
			.blog-content a {
				text-decoration-color: var(--accent);
				text-underline-offset: 4px;
			}
			.blog-content :not(pre) > code {
				padding: 2px 5px;
				background: var(--line);
				font: 0.82em var(--mono);
			}
			.blog-content pre {
				overflow-x: auto;
				margin: 24px 0;
				padding: 20px;
				background: var(--panel);
				color: var(--bg);
				font: 14px/1.7 var(--mono);
			}
			.blog-content pre code {
				font: inherit;
			}
			.blog-empty {
				padding: 24px 0;
				color: var(--muted);
			}
			body > footer.wrap {
				display: flex;
				align-items: center;
				gap: 4px;
			}
			body > footer.wrap a,
			body > footer.wrap a:hover {
				text-decoration: none;
			}
			@media (max-width: 600px) {
				.blog-page {
					width: calc(100% - 32px);
					padding: 44px 0 64px;
				}
				.blog-list {
					margin-top: 44px;
				}
				.blog-entry {
					grid-template-columns: 1fr;
					gap: 8px;
					padding: 20px 0;
				}
				.blog-article .blog-meta {
					margin-bottom: 32px;
				}
				body > footer.wrap {
					flex-wrap: wrap;
					gap: 4px;
				}
				.blog-content {
					font-size: 17px;
				}
				.blog-content pre {
					margin-inline: -16px;
					padding: 16px;
					font-size: 12px;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.blog-entry h2 {
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<SiteHeader isHome={false} />
		<main id="top"><slot /></main>
		<footer class="wrap">
			<span>nugraha@dev:~$</span>
			<a href="/">Kembali ke portfolio</a>
		</footer>
	</body>
</html>
