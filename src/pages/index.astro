---
const projects = [
	{
		label: "PROJECT / CLIENT",
		title: "Hushpuppies",
		idDescription: "Salah satu project klien yang pernah saya tangani selama bekerja di ICUBE.",
		enDescription: "A client project I handled while working at ICUBE.",
		tag: "Client project",
	},
	{
		label: "KAWAN LAMA GROUP",
		title: "ACE & Informa",
		idDescription: "Project untuk brand di bawah Kawan Lama Group.",
		enDescription: "A project for brands within Kawan Lama Group.",
		tag: "Retail",
	},
	{
		label: "SUPPORT PROJECT",
		title: "OMS support",
		idDescription: "Dukungan project untuk Omnichannel Management System.",
		enDescription: "Project support for an Omnichannel Management System.",
		tag: "OMS",
	},
];
const focusAreas = [
	{
		label: "PRODUCTS",
		idTitle: "Produk yang pernah ditangani",
		enTitle: "Products I’ve worked on",
		idBody: "OMS · PIM · Affiliate · Journal · Marketplace Adapter · Belanjaku",
		enBody: "OMS · PIM · Affiliate · Journal · Marketplace Adapter · Belanjaku",
	},
	{
		label: "INTEGRATIONS",
		idTitle: "Kanal marketplace",
		enTitle: "Marketplace channels",
		idBody: "Shopee · TikTok · Lazada · Blibli · Shopify",
		enBody: "Shopee · TikTok · Lazada · Blibli · Shopify",
	},
	{
		label: "KNOWLEDGE SHARING",
		idTitle: "Trainer di Kawan Lama",
		enTitle: "Trainer at Kawan Lama",
		idBody: "Mengisi training untuk tim Kawan Lama.",
		enBody: "Delivered training for the Kawan Lama team.",
	},
];
import SiteHeader from "../components/SiteHeader.astro";
import HeroTerminal from "../components/HeroTerminal.jsx";
import ControlPlane from "../components/ControlPlane.jsx";
import PortfolioStyles from "../components/PortfolioStyles.astro";
---

<!doctype html>
<html lang="id" data-language="id">
  <head>
    <PortfolioStyles />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta
      name="description"
      content="Agung Nugraha, software engineer berfokus pada backend dan terbuka untuk peluang kerja."
    />
    <meta name="theme-color" content="#F3EEE3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Reddit+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Agung Nugraha | Backend Engineer</title>
    <script is:inline>
      try {
        const language = localStorage.getItem("nugraha-language");
        if (language === "en" || language === "id") {
          document.documentElement.dataset.language = language;
          document.documentElement.lang = language;
        }
        if (localStorage.getItem("nugraha-theme") === "dark")
          document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>

  </head>
  <body>
    <SiteHeader />
    <main id="top">
      <HeroTerminal client:load />
      <ControlPlane client:load />
      <section id="projects" class="wrap project-section">
        <div class="work-heading">
          <div>
            <p class="eyebrow">ls projects/ --handled</p>
            <h2><span class="lang-id">Project yang pernah saya tangani.</span><span class="lang-en">Work I’ve handled.</span></h2>
          </div>
          <p class="lead"><span class="lang-id">Pengalaman di platform commerce, sistem omnichannel, dan dukungan produk.</span><span class="lang-en">Experience across commerce platforms, omnichannel systems, and product support.</span></p>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <article class="project-row">
              <p class="project-label">{project.label}</p>
              <h3>{project.title}</h3>
              <div class="project-description">
                <p><span class="lang-id">{project.idDescription}</span><span class="lang-en">{project.enDescription}</span></p>
                <span class="project-tag">{project.tag}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="focus-section">
        <div class="wrap">
          <div class="focus-heading">
            <div>
              <p class="eyebrow">/engineering/surface</p>
              <h2><span class="lang-id">Sistem, kanal, dan tim.</span><span class="lang-en">Systems, channels, and teams.</span></h2>
            </div>
            <p class="lead"><span class="lang-id">Area kerja yang menghubungkan backend dengan operasional produk.</span><span class="lang-en">Work that connects backend systems with product operations.</span></p>
          </div>
          <div class="focus-grid">
            {focusAreas.map((area, index) => (
              <article class={`focus-card focus-card-${index + 1}`}>
                <p class="focus-label">0{index + 1} / {area.label}</p>
                <h3><span class="lang-id">{area.idTitle}</span><span class="lang-en">{area.enTitle}</span></h3>
                <p><span class="lang-id">{area.idBody}</span><span class="lang-en">{area.enBody}</span></p>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section id="contact" class="contact">
        <div class="wrap contact-inner">
          <div>
            <p class="meta">POST /contact</p><h2><span class="lang-id">Mari bahas sistem di balik produk Anda.</span><span class="lang-en">Let’s talk about the system behind your product.</span></h2>
          </div><div class="contact-actions">
            <a class="contact-email" href="mailto:nugraha.an96@gmail.com"><span class="lang-id">Email saya</span><span class="lang-en">Email me</span></a>
            <p class="contact-address">nugraha.an96@gmail.com</p>
            <div class="social-links" aria-label="Social media">
              <a class="social-link" href="https://www.linkedin.com/in/your-linkedin" aria-label="LinkedIn, ganti URL profil"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6ZM3.7 9h3v11.3h-3V9Zm5 0h2.9v1.5h.1A3.2 3.2 0 0 1 14.6 8c3.1 0 3.7 2 3.7 4.6v7.7h-3v-6.8c0-1.6 0-3.6-2.2-3.6s-2.5 1.7-2.5 3.5v6.9h-3V9Z"/></svg><span>LinkedIn</span></a>
              <a class="social-link" href="https://github.com/your-github" aria-label="GitHub, ganti URL profil"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.82c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.62 1.22 3.26.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.16a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.08-1.16 3.08-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.32-2.63 5.27-5.14 5.55.4.35.75 1.03.75 2.08v3.1c0 .3.2.65.78.54A11.2 11.2 0 0 0 12 .8Z"/></svg><span>GitHub</span></a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <span>© {new Date().getFullYear()} Agung Nugraha</span>
      <span class="footer-credit">
        <span class="lang-id">Dibuat dengan Astro</span>
        <span class="lang-en">Built with Astro</span>
      </span>
		</footer>

  </body>
</html>
