---
const projects = ["Hushpuppies", "ACE & Informa", "OMS support"];
const products = ["OMS", "PIM", "Affiliate", "Journal", "Marketplace Adapter", "Belanjaku"];
const jobs = [
	{ period: "2019—2020", role: "Junior Backend Engineer", company: "ICUBE" },
	{ period: "2020—2025", role: "Software Engineer", company: "iCube by SIRCLO" },
	{ period: "2025—Sekarang", role: "Software Engineer", company: "ICUBE" },
];
import SiteHeader from "../components/SiteHeader.astro";
import HeroTerminal from "../components/HeroTerminal.jsx";
import ControlPlane from "../components/ControlPlane.jsx";
import PortfolioStyles from "../components/PortfolioStyles.astro";
---

<!doctype html>
<html lang="id" data-language="id">
  <head>
    <PortfolioStyles />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Agung Nugraha, software engineer berfokus pada backend dan terbuka untuk peluang kerja."
    />
    <meta name="theme-color" content="#F3EEE3" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Reddit+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Agung Nugraha | Backend Engineer</title>
    <script is:inline>
      try {
        const language = localStorage.getItem("nugraha-language");
        if (language === "en" || language === "id") {
          document.documentElement.dataset.language = language;
          document.documentElement.lang = language;
        }
        if (localStorage.getItem("nugraha-theme") === "dark")
          document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>

  </head>
  <body>
    <SiteHeader />
    <main id="top">
      <HeroTerminal client:load />
      <ControlPlane client:load />
      <section id="projects" class="wrap project-section">
        <div class="section-heading">
          <div>
            <p class="meta">ls projects/ --handled</p><h2><span class="lang-id">Pekerjaan yang mendukung operasional nyata.</span><span class="lang-en">Work connected to real operations.</span></h2>
          </div>
        </div>{
          projects.map((project, index) => (
            <article class="project-row">
              <>
                <p>
                  {index === 1
                    ? "KAWAN LAMA GROUP"
                    : index === 2
                      ? "SUPPORT PROJECT"
                      : "PROJECT / CLIENT"}
                </p>
                <h3>{project}</h3>
              </>
            </article>
          ))
        }
      </section>
      <section id="contact" class="contact">
        <div class="wrap contact-inner">
          <div>
            <p class="meta">POST /contact</p><h2><span class="lang-id">Mari bahas sistem di balik produk Anda.</span><span class="lang-en">Let’s talk about the system behind your product.</span></h2>
          </div><div class="contact-actions">
            <a class="contact-email" href="mailto:nugraha.an96@gmail.com"><span class="lang-id">Email saya</span><span class="lang-en">Email me</span></a>
            <p class="contact-address">nugraha.an96@gmail.com</p>
            <div class="social-links" aria-label="Social media">
              <a class="social-link" href="https://www.linkedin.com/in/your-linkedin" aria-label="LinkedIn, ganti URL profil"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.2 3.5a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6ZM3.7 9h3v11.3h-3V9Zm5 0h2.9v1.5h.1A3.2 3.2 0 0 1 14.6 8c3.1 0 3.7 2 3.7 4.6v7.7h-3v-6.8c0-1.6 0-3.6-2.2-3.6s-2.5 1.7-2.5 3.5v6.9h-3V9Z"/></svg><span>LinkedIn</span></a>
              <a class="social-link" href="https://github.com/your-github" aria-label="GitHub, ganti URL profil"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.82c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.62 1.22 3.26.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.24 1.16-3.03-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.16a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.08-1.16 3.08-1.16.61 1.55.23 2.7.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.32-2.63 5.27-5.14 5.55.4.35.75 1.03.75 2.08v3.1c0 .3.2.65.78.54A11.2 11.2 0 0 0 12 .8Z"/></svg><span>GitHub</span></a>
            </div>
          </div>
        </div>
      </section>
    </main><footer class="wrap">
      © {new Date().getFullYear()} Agung Nugraha <span style="float:right"
        ><span class="lang-id">dibangun sebagai control plane backend</span><span class="lang-en">built as a backend control plane</span></span
      >
    </footer>

  </body>
</html>
